# Copy to .env.local. Never commit the real file (gitignored at repo root).

# Where apps/api is running.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Optional — only needed to offer WalletConnect as a fallback connector.
# Without it, the injected connector (OKX Wallet extension, MetaMask, etc.)
# still works fine; this is purely for users without a browser extension.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
