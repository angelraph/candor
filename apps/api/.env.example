# Copy to .env. Never commit the real .env (gitignored at repo root).

PORT=8787
NODE_ENV=development

# Which X Layer network this instance targets: 1952 (testnet) or 196 (mainnet).
CHAIN_ID=1952
RPC_URL=https://testrpc.xlayer.tech/terigon

# From packages/contracts deploy output (see Deploy.s.sol log).
ASSET_TOKEN_ADDRESS=
RWA_VAULT_ADDRESS=
REASONING_LEDGER_ADDRESS=

# Backend-only signer authorized on ReasoningLedger.recordVerdict(). This key
# never touches user funds — it only anchors verdict receipts — but treat it
# as a real secret regardless. Must match the AGENT_SIGNER_ADDRESS the
# contracts were deployed with (or whatever you later rotate it to via
# ReasoningLedger.setAgentSigner).
AGENT_SIGNER_PRIVATE_KEY=

# OKX DEX Aggregator API (web3.okx.com). Leave blank to run in mock mode —
# the pipeline still works end-to-end against synthetic quotes, useful for
# building the rest of the stack before API access is approved.
OKX_DEX_API_KEY=
OKX_DEX_API_SECRET=
OKX_DEX_API_PASSPHRASE=
OKX_DEX_PROJECT_ID=
OKX_DEX_BASE_URL=https://web3.okx.com

# OpenAI API — powers the slow-path intent parser and the LLM risk verdict
# for borderline/large requests. Leave blank to run in rule-only mode (fast
# path + rule-engine verdicts still work; novel-phrasing and borderline-case
# handling won't).
OPENAI_API_KEY=
