# Copy to .env and fill in. Never commit the real .env (already gitignored at repo root).

# Deployer wallet — funded with testnet OKB (faucet) / real OKB (mainnet gas) respectively.
PRIVATE_KEY=

# X Layer RPCs (public endpoints shown; swap for a private/rate-limited one if needed).
X_LAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
X_LAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech

# Optional: OKLink API key for contract source verification after deploy.
OKLINK_API_KEY=

# The address (agent signer) authorized to call ReasoningLedger.recordVerdict().
# Should match the backend's signer — see apps/api/.env.example AGENT_SIGNER_PRIVATE_KEY.
AGENT_SIGNER_ADDRESS=
